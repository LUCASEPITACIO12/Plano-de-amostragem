class TestValidacoes:
    def _sis(self, **kwargs):
        defaults = dict(municipio="Test", nome="SAA Test",
                        localidades="", populacao=10_000)
        defaults.update(kwargs)
        return Sistema(**defaults)

    def test_filtros_em_simples_desinfeccao_avisa(self):
        s = self._sis(
            tratamento="Simples Desinfecção (Superficial – sem ETA)",
            n_filtros=4,
        )
        avisos = validar_sistema(s)
        assert any("ignorado" in a.lower() for a in avisos)

    def test_eta_sem_filtros_avisa(self):
        s = self._sis(
            tratamento="ETA Convencional (Filtração Rápida)",
            n_filtros=0,
        )
        avisos = validar_sistema(s)
        assert any("filtros" in a.lower() for a in avisos)

    def test_manancial_declarado_diverge_avisa(self):
        s = self._sis(
            manancial="Superficial",
            captacoes=[Captacao("Poço", "Subterrâneo")],
        )
        avisos = validar_sistema(s)
        assert any("superficiais" in a.lower() for a in avisos)


