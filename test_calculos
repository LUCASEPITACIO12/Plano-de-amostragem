class TestCalcPSD:
    def test_superficial_pequeno(self):
        r = calc_psd(tem_superficial=True, populacao=30_000)
        assert r == {"qtd": 1, "freq": "Bimestral", "meses": MESES_BIMESTRAL}

    def test_superficial_medio(self):
        r = calc_psd(tem_superficial=True, populacao=200_000)
        assert r["qtd"] == 4
        assert r["freq"] == "Bimestral"

    def test_superficial_grande(self):
        r = calc_psd(tem_superficial=True, populacao=300_000)
        assert r["qtd"] == 8

    def test_subterraneo_pequeno_anual(self):
        r = calc_psd(tem_superficial=False, populacao=30_000)
        assert r["freq"] == "Anual"
        assert r["meses"] == MES_ANUAL

    def test_subterraneo_medio_semestral(self):
        r = calc_psd(tem_superficial=False, populacao=100_000)
        assert r["freq"] == "Semestral"
        assert r["qtd"] == 2


class TestParamsPSDPorDesinfetante:
    def test_hipoclorito_sem_preoxidacao(self):
        params = calc_params_psd("Hipoclorito de Sódio (NaOCl)",
                                 "Não realiza pré-oxidação")
        assert "Bromato" not in params  # cloro não gera bromato
        assert "Clorato" in params
        assert "Cloraminas Total" not in params

    def test_cloraminas_exige_ndma_e_thm(self):
        params = calc_params_psd("Cloraminas (cloraminação)",
                                 "Não realiza pré-oxidação")
        assert "N-nitrosodimetilamina" in params
        assert "Cloraminas Total" in params
        assert "Trihalometanos Total" in params

    def test_ozonio_exige_bromato(self):
        params = calc_params_psd("Ozônio (O₃)",
                                 "Não realiza pré-oxidação")
        assert "Bromato" in params

    def test_preoxidacao_ozonio_inclui_bromato_mesmo_com_cloro(self):
        """Cenário real: desinfetante cloro + pré-oxidação ozônio → Bromato obrigatório."""
        params = calc_params_psd("Hipoclorito de Sódio (NaOCl)", "Ozônio")
        assert "Bromato" in params

    def test_dioxido_cloro_minimo(self):
        params = calc_params_psd("Dióxido de Cloro (ClO₂)",
                                 "Não realiza pré-oxidação")
        assert set(params) == {"Clorato", "Clorito"}


