class TestLinhaPlano:
    def test_quantidade_no_mes_dentro_da_lista(self):
        l = LinhaPlano(
            etapa="X", grupo="X", parametro="X",
            ponto_tipo="X", ponto_desc="X",
            frequencia="Semestral", quantidade=2,
            meses_coleta=[1, 7], base_legal="X",
        )
        assert l.quantidade_no_mes(1) == 2
        assert l.quantidade_no_mes(3) == 0

    def test_total_anual_simples(self):
        l = LinhaPlano(
            etapa="X", grupo="X", parametro="X",
            ponto_tipo="X", ponto_desc="X",
            frequencia="Trimestral", quantidade=1,
            meses_coleta=MESES_TRIMESTRAL, base_legal="X",
        )
        assert l.total_anual == 4

    def test_a_cada_2h_24h(self):
        l = LinhaPlano(
            etapa="X", grupo="X", parametro="X",
            ponto_tipo="X", ponto_desc="X",
            frequencia="A cada 2 horas", quantidade=1,
            meses_coleta=list(range(1, 13)), base_legal="X",
            horas_dia=24,
        )
        # 12 amostras/dia × 365 dias = 4380
        assert l.total_anual == 12 * 365

    def test_a_cada_2h_12h(self):
        l = LinhaPlano(
            etapa="X", grupo="X", parametro="X",
            ponto_tipo="X", ponto_desc="X",
            frequencia="A cada 2 horas", quantidade=1,
            meses_coleta=list(range(1, 13)), base_legal="X",
            horas_dia=12,
        )
        # 6 amostras/dia × 365 = 2190
        assert l.total_anual == 6 * 365

    def test_is_operacional(self):
        for freq in ("A cada 2 horas", "Diário"):
            l = LinhaPlano(
                etapa="X", grupo="X", parametro="X",
                ponto_tipo="X", ponto_desc="X",
                frequencia=freq, quantidade=1,
                meses_coleta=[1], base_legal="X",
            )
            assert l.is_operacional is True


