# Anexo 14 – pontos mínimos na rede
# ══════════════════════════════════════════════════════════════════════════════

class TestAnexo14:
    def test_pop_zero(self):
        assert calc_anexo14(0) == 5

    def test_faixa_minima(self):
        assert calc_anexo14(2_500) == 5

    def test_faixa_5_10k(self):
        assert calc_anexo14(7_000) == 10

    def test_faixa_10_50k(self):
        assert calc_anexo14(30_000) == 30
        assert calc_anexo14(50_000) == 50

    def test_faixa_50_80k(self):
        # 25 + ceil(65000/2000) = 25 + 33 = 58
        assert calc_anexo14(65_000) == 58

    def test_teto_400(self):
        # O teto 400 só é alcançado em pop muito grande:
        # 244 + ceil(pop/20.000) ≥ 400 → pop ≥ ~3.120.000
        # min(400, ...) garante que nunca passa de 400.
        assert calc_anexo14(50_000_000) == 400
        assert calc_anexo14(2_000_000) < 400  # ainda na fórmula

    def test_minimo_da_ultima_faixa(self):
        # Garante que pop bem grande não estoura 400
        assert calc_anexo14(10_000_000) == 400

    def test_pop_negativa_vira_zero(self):
        assert calc_anexo14(-100) == 5


class TestFaixaPopulacional:
    def test_strings_legiveis(self):
        assert "5.000" in faixa_populacional(2_500)
        assert "máx. 400" in faixa_populacional(2_000_000)


