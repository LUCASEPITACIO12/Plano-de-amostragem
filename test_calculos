class TestSistemaProperties:
    def _sis(self, **kwargs):
        defaults = dict(municipio="Test", nome="SAA Test", localidades="")
        defaults.update(kwargs)
        return Sistema(**defaults)

    def test_default_captacao_subterraneo(self):
        s = self._sis(manancial="Subterrâneo")
        assert len(s.captacoes) == 1
        assert s.captacoes[0].is_superficial is False
        assert s.tem_subterraneo is True
        assert s.tem_superficial is False

    def test_default_captacao_superficial(self):
        s = self._sis(manancial="Superficial")
        assert s.captacoes[0].is_superficial is True
        assert s.tem_superficial is True

    def test_misto_via_captacoes(self):
        s = self._sis(captacoes=[
            Captacao("Poço 1", "Subterrâneo"),
            Captacao("Rio X", "Superficial"),
        ])
        assert s.is_misto is True
        assert s.manancial_efetivo == "Misto"

    def test_manancial_efetivo_derivado(self):
        # Mesmo declarando "Subterrâneo", se as captações forem superficiais...
        s = self._sis(
            manancial="Subterrâneo",
            captacoes=[Captacao("Rio", "Superficial")],
        )
        # A verdade está nas captações
        assert s.manancial_efetivo == "Superficial"


