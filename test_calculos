class TestGerarPlano:
    def _saa_padrao(self, **overrides):
        defaults = dict(
            municipio="Batalha", nome="SAA Bacia",
            localidades="Urbano", tipo="SAA",
            manancial="Superficial", populacao=20_000,
            n_filtros=4, tratamento="ETA Convencional (Filtração Rápida)",
        )
        defaults.update(overrides)
        return Sistema(**defaults)

    def test_saa_completo_gera_captacao_filtros_saida_rede(self):
        s = self._saa_padrao(escopo="completo")
        linhas = gerar_plano(s)
        etapas = {l.etapa for l in linhas}
        assert "Água Bruta – Captação" in etapas
        assert "Saída por Filtro" in etapas
        assert "Saída do Tratamento" in etapas
        assert "Rede de Distribuição" in etapas

    def test_saa_trat_dist_nao_gera_captacao(self):
        s = self._saa_padrao(escopo="trat_dist")
        linhas = gerar_plano(s)
        etapas = {l.etapa for l in linhas}
        assert "Água Bruta – Captação" not in etapas
        assert "Saída do Tratamento" in etapas
        assert "Rede de Distribuição" in etapas

    def test_saa_dist_so_rede(self):
        s = self._saa_padrao(escopo="dist")
        linhas = gerar_plano(s)
        etapas = {l.etapa for l in linhas}
        assert etapas == {"Rede de Distribuição"}

    def test_filtros_geram_uma_linha_por_unidade(self):
        s = self._saa_padrao(n_filtros=6)
        linhas = gerar_plano(s)
        linhas_filtro = [l for l in linhas if l.etapa == "Saída por Filtro"]
        descs = {l.ponto_desc for l in linhas_filtro}
        assert len(descs) == 6

    def test_simples_desinfeccao_nao_gera_filtros(self):
        s = self._saa_padrao(
            tratamento="Simples Desinfecção (Superficial – sem ETA)",
            n_filtros=0,
        )
        linhas = gerar_plano(s)
        assert not any(l.etapa == "Saída por Filtro" for l in linhas)

    def test_misto_psd_vai_para_rede_nao_saida(self):
        """Sistemas com qualquer captação superficial: PSD na rede, não na saída."""
        s = self._saa_padrao(
            captacoes=[
                Captacao("Poço 1", "Subterrâneo"),
                Captacao("Rio X", "Superficial"),
            ],
        )
        linhas = gerar_plano(s)
        psd_saida = [l for l in linhas
                     if l.grupo == "Prod. Sec. da Desinfecção"
                     and l.etapa == "Saída do Tratamento"]
        psd_rede = [l for l in linhas
                    if l.grupo == "Prod. Sec. da Desinfecção"
                    and l.etapa == "Rede de Distribuição"]
        assert len(psd_saida) == 0
        assert len(psd_rede) > 0

    def test_subterraneo_psd_na_saida(self):
        s = self._saa_padrao(
            captacoes=[Captacao("Poço 1", "Subterrâneo")],
        )
        linhas = gerar_plano(s)
        psd_saida = [l for l in linhas
                     if l.grupo == "Prod. Sec. da Desinfecção"
                     and l.etapa == "Saída do Tratamento"]
        assert len(psd_saida) > 0

    def test_captacao_superficial_tem_cianobacterias(self):
        s = self._saa_padrao(captacoes=[Captacao("Rio", "Superficial")])
        linhas = gerar_plano(s)
        ciano = [l for l in linhas if "Cianobactéria" in l.parametro]
        assert len(ciano) == 1

    def test_captacao_subterranea_nao_tem_cianobacterias(self):
        s = self._saa_padrao(
            manancial="Subterrâneo",
            captacoes=[Captacao("Poço", "Subterrâneo")],
        )
        linhas = gerar_plano(s)
        ciano = [l for l in linhas if "Cianobactéria" in l.parametro]
        assert len(ciano) == 0

    def test_subterraneo_tem_condutividade(self):
        s = self._saa_padrao(
            manancial="Subterrâneo",
            captacoes=[Captacao("Poço", "Subterrâneo")],
        )
        linhas = gerar_plano(s)
        cond = [l for l in linhas if "Condutividade" in l.parametro]
        assert len(cond) == 1

    def test_superficial_tem_dqo_dbo_od(self):
        s = self._saa_padrao(captacoes=[Captacao("Rio", "Superficial")])
        linhas = gerar_plano(s)
        params = {l.parametro for l in linhas}
        assert "DQO" in params and "DBO" in params and "OD" in params

    def test_pontos_rede_batem_anexo14(self):
        s = self._saa_padrao(populacao=30_000)  # → 30 pontos
        linhas = gerar_plano(s)
        # Filtrar apenas pontos FQ "regulares" da rede (não PSD nem condicionais)
        pontos = {l.ponto_desc for l in linhas
                  if l.etapa == "Rede de Distribuição"
                  and l.grupo == "Físico-Químico e Microbiológico"
                  and l.parametro in PARAMS_FQ_BASICO}
        assert len(pontos) == 30


